# Synth AI API key (get from https://usesynth.ai)
SYNTH_API_KEY=your_synth_api_key_here

# Kernel API key (get from https://onkernel.com)
KERNEL_API_KEY=your_kernel_api_key_here
KERNEL_BASE_URL=https://api.onkernel.com

# Anthropic API key (for Claude Code and LLM verifier)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override task app URL (e.g., for ngrok tunnel)
# TASK_APP_URL=https://your-subdomain.ngrok-free.app
